.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints and autosaves
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Environment variables, credentials, and local settings
.env
.env.*
*.env
secrets.json
*.pem
*.key

# IDE and editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
*~

# Generated artifacts and outputs (keep empty dir structures via .gitkeep)
# Uncomment lines below if large generated files or charts should remain untracked locally
# outputs/*
# !outputs/.gitkeep
# models/*
# !models/.gitkeep

# Datasets policy:
# Small raw sample metadata is tracked.
# Exclude large binary dumps, archives, and bulk raw drops:
*.zip
*.tar.gz
*.7z
*.rar
data/processed/*.parquet
data/processed/*.feather
